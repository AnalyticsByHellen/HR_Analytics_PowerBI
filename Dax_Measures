DAX MEASURES

DEFINE

MEASURE 'HR_Analytics-4 (2)'[Total Employees] =
COUNTROWS('HR_Analytics-4 (2)')

MEASURE 'HR_Analytics-4 (2)'[Employees Left] =
CALCULATE(
    COUNTROWS('HR_Analytics-4 (2)'),
    'HR_Analytics-4 (2)'[Attrition]="Yes"
)

MEASURE 'HR_Analytics-4 (2)'[Employees Active] =
CALCULATE(
    COUNTROWS('HR_Analytics-4 (2)'),
    'HR_Analytics-4 (2)'[Attrition]="No"
)

MEASURE 'HR_Analytics-4 (2)'[Attrition Rate] =
DIVIDE(
    [Employees Left],
    [Total Employees],
    0
)

MEASURE 'HR_Analytics-4 (2)'[Average Age] =
AVERAGE('HR_Analytics-4 (2)'[Age])

MEASURE 'HR_Analytics-4 (2)'[Average Monthly Income] =
AVERAGE('HR_Analytics-4 (2)'[MonthlyIncome])

MEASURE 'HR_Analytics-4 (2)'[Total Monthly Income] =
SUM('HR_Analytics-4 (2)'[MonthlyIncome])

